# Same Postgres instance as the main OpenCloudCRM app -- do not point this
# at a separate database. Schema: scripts/migrations/029_voice_agent.sql in
# the main repo.
DATABASE_URL=

# Must be byte-identical to the main app's SESSION_SECRET (same Coolify env
# var name on whatever you've deployed the main app as) -- this service
# verifies call-session tokens minted there, it does not mint its own.
SESSION_SECRET=

# Providers
ASSEMBLYAI_API_KEY=
FISH_API_KEY=
FISH_MODEL_ID=
# Selects Fish Audio's free tier (s2.1-pro-free) via a request header --
# without this the account is billed against its pollen balance instead.
FISH_MODEL=s2.1-pro-free
GEMINI_API_KEY=
OPENAI_API_KEY=
POLLINATIONS_API_KEY=

# CORS + WS origin allowlist. Comma-separated, no spaces. Must include the
# main site's production origin and localhost for dev.
ALLOWED_ORIGINS=https://www.indishmarketer.com,https://indishmarketer.com,http://localhost:3000

# Call tuning
SESSION_MAX_SECONDS=300
VOICE_SESSIONS_PER_USER_PER_DAY=3
MAX_REPLY_CHARS=500
AAI_SPEECH_MODEL=universal-3-5-pro
FISH_LATENCY=balanced
FISH_SAMPLE_RATE=24000

# Branding (used to build the system prompt, see src/prompts.js)
BRAND_NAME=Indish Marketer
AGENT_NAME=Indish Marketer Assistant
WEBSITE_URL=https://indishmarketer.com
GREETING=Hi, welcome to Indish Marketer. How can I help you today?

PORT=4000
