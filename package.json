{
  "name": "opencloudcrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-console-search-exclusions.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-console-search-exclusions.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --loader ./test/alias-loader.mjs --test test/**/*.test.mjs test/**/*.test.ts",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:seo:strict": "node scripts/audit-seo.mjs --strict",
    "audit:seo:urls": "node scripts/audit-seo.mjs --check-urls",
    "audit:seo:report": "node scripts/audit-seo.mjs --report=.agent-memory/seo-audit-latest.json",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status"
  },
  "overrides": {
    "qs": "^6.16.0",
    "js-yaml": "^4.3.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-sesv2": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mux/mux-player-react": "^3.13.2",
    "@sentry/nextjs": "^10.74.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/extension-youtube": "^3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "googleapis": "^174.0.1",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.70.0",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "undici": "^7.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
