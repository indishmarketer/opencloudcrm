# ---------------------------------------------------------------------------
# Runtime environment variables for OpenCloudCRM, the Next.js app in this
# repo. In production these are typically set on your host/platform (e.g.
# Coolify), not in a local .env file. This file documents the full set so a
# fresh deploy can be reconstructed and so missing/misnamed keys are caught.
# Values below are placeholders -- replace them with real secrets.
# ---------------------------------------------------------------------------

# --- Core / database ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/opencloudcrm
SESSION_SECRET=replace-with-a-long-random-string

# --- Identity / email ---
ADMIN_EMAIL=support@example.com
EMAIL_FROM=support@example.com
# Two supported providers -- set credentials for either (or both). With
# both set, EMAIL_PROVIDER picks explicitly; otherwise SES wins if both
# have credentials. Console login is a magic link, so without ONE of
# these working you cannot log into /console at all -- if that's you on
# a fresh deploy, check the server logs: the login link gets printed
# there instead of silently failing to send (see
# src/app/api/console/magic-link/route.ts).
EMAIL_PROVIDER=
# Amazon SES -- use a dedicated send-only IAM user, not your root/admin
# keys. Getting SES out of its sandbox/production-access approval can
# take Amazon a few days for a brand-new account -- Brevo below is the
# faster option to get a working deployment today.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# SNS -> /api/webhooks/ses-sns?secret=... for delivery/bounce/complaint events
SES_SNS_WEBHOOK_SECRET=
SES_SNS_TOPIC_ARN=
# Brevo (formerly Sendinblue) -- usable on its free tier within minutes,
# no approval wait. Dashboard -> SMTP & API -> API Keys.
BREVO_API_KEY=
# Console login's magic-link requests are rate limited (default 5 per IP
# per 10 min, 3 per email per hour) -- raise these temporarily if you're
# stuck iterating on SES/Brevo setup and keep hitting the limit, then set
# back (or unset, to restore the defaults) once things work.
MAGIC_LINK_IP_RATE_LIMIT=
MAGIC_LINK_EMAIL_RATE_LIMIT=

# --- Turnstile (bot protection) ---
# NOTE: the client widget reads the NEXT_PUBLIC_ prefix; the server verifies
# against the secret. Both must be present or all captcha-gated forms fail.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Public site ---
# Must match the canonical domain exactly, including "www." if the site
# redirects apex -> www (or vice versa) -- OAuth providers below match
# redirect_uri literally, so a mismatch here breaks every SSO button.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Single sign-on (Google/GitHub/LinkedIn, src/lib/sso.ts) ---
# Each pair's redirect URI to register with the provider:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/oauth/<google|github|linkedin>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Brand / identity (src/config/brand.ts) ---
# Every var below falls back to a generic placeholder if unset, so a fresh
# install never silently inherits another deployment's brand. Set your own
# values here, not in src/config/brand.ts.
NEXT_PUBLIC_SITE_NAME=My Business
# CDN/image subdomain, e.g. the "images." in images.example.com
NEXT_PUBLIC_ASSET_DOMAIN=images.example.com
# Same value as NEXT_PUBLIC_ASSET_DOMAIN, set again WITHOUT the
# NEXT_PUBLIC_ prefix. Next.js inlines every NEXT_PUBLIC_* var into the
# compiled app at image-build time (see the note above docker-compose.yml's
# Brand section) -- on the project's own published image that's already
# baked with no deployment-specific value, so it can never pick up your
# real asset domain from just this env var. This plain-named twin has no
# such prefix, so it's never inlined: it's read fresh on every request by
# src/middleware.ts and used to build the Content-Security-Policy header
# that actually controls whether your images are allowed to load in the
# browser. Set both; if you build your own image with the right
# NEXT_PUBLIC_ASSET_DOMAIN build arg, this one becomes redundant but
# harmless to also set.
ASSET_DOMAIN=images.example.com

# --- Color palette (optional, src/app/globals.css's :root defaults shown) ---
# Uncomment and change any of these to pick your own palette instead of the
# default black-on-white. Leave unset to keep the defaults.
# NEXT_PUBLIC_COLOR_INK=#0a0a0a
# NEXT_PUBLIC_COLOR_PAPER=#ffffff
# NEXT_PUBLIC_COLOR_PAPER_SOFT=#f5f5f4
# NEXT_PUBLIC_COLOR_INK_SOFT=#4b4b4b
# NEXT_PUBLIC_COLOR_LINE=#e2e2e0

# --- NOT environment variables any more ---
# Business details (owner, registration number, address, phone, hours,
# emails), the policy numbers on the legal pages (refund window, minimum
# age, governing law), social links, the header menu, the footer and every
# page's content are edited in the console, not here:
#   /console/site-settings  -> Business details
#   /console/pages          -> pages, and "Menu & footer"
# Old BUSINESS_*, LEGAL_* and NEXT_PUBLIC_SOCIAL_* values are still read
# until you save those screens once, then they can be deleted.

# --- Analytics / ads ---
# GA4 Admin > Data streams > Measurement ID, e.g. G-XXXXXXXXXX. Unset means
# no GA4 tracking at all, client or server side -- never falls back to this
# project's own property.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# GA4 Admin > Data streams > Measurement Protocol API secrets. Server-side purchase events.
GA4_API_SECRET=
BING_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Payments ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# "sandbox" or unset/"live". Defaults to live -- set this to "sandbox" while
# testing, or real PayPal charges go through.
PAYPAL_ENV=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cal.com (meetings) ---
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# --- Mux (video/webinars) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
MUX_WEBHOOK_SECRET=
MUX_WEBHOOK_SIGNING_SECRET=

# --- Cloudflare R2 (uploads/course videos) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=
R2_PUBLIC_URL=
R2_COURSES_BUCKET=
R2_BACKUP_BUCKET=
# Separate bucket for inbound WhatsApp media (src/lib/whatsappMediaStore.ts).
# Optional -- WhatsApp media handling just no-ops without it.
R2_WHATSAPP_BUCKET=

# --- Blog image search (optional Pexels integration) ---
PEXELS_API_KEY=

# --- Cloudflare (SEO/cache) ---
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_TOKEN=

# --- Google Business Profile ---
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI=
GOOGLE_BUSINESS_PUBSUB_TOPIC=
GOOGLE_BUSINESS_PUBSUB_AUDIENCE=
GOOGLE_BUSINESS_PUBSUB_SERVICE_ACCOUNT=

# --- Cron jobs (protect /api/cron/*) ---
CRON_SECRET=

# --- Outbound webhooks (generic /api/webhooks/[slug]) ---
WEBHOOK_SHARED_SECRET=

# --- WhatsApp Business API (/api/webhooks/whatsapp, src/lib/whatsapp.ts) ---
# WHATSAPP_VERIFY_TOKEN: any string you choose, pasted into the Meta app
# dashboard's "Verify token" field alongside the Callback URL.
# WHATSAPP_APP_SECRET: the app's secret from App settings > Basic, used to
# verify the X-Hub-Signature-256 header on every webhook POST.
# WHATSAPP_ACCESS_TOKEN: a permanent token for the app (System User token,
# not the 24h test token from the dashboard).
# WHATSAPP_PHONE_NUMBER_ID: the sending number's Phone Number ID (not the
# phone number itself), from WhatsApp Manager > Phone numbers.
# WHATSAPP_WABA_ID: the WhatsApp Business Account id (the "Messaging account
# ID", also the asset_id in WhatsApp Manager's own URLs). Account-level, so
# it covers every number; needed by the console's template management, which
# is WABA-scoped rather than number-scoped. Not a secret.
# WHATSAPP_APP_ID: the Meta app's id, from the app dashboard. Only used to
# open resumable upload sessions for template header media (Meta scopes
# uploads to the app, not the WABA). Not a secret.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_ID=
# Days before an inbound/outbound media file is deleted (message stays,
# only the file goes). Optional -- defaults to 180. Set to 0 to keep forever.
WHATSAPP_MEDIA_RETENTION_DAYS=

# --- Error tracking (optional) ---
# SENTRY_DSN is server-side (src/instrumentation.ts); NEXT_PUBLIC_SENTRY_DSN
# is the client-side one (src/instrumentation-client.ts). Both needed for
# full coverage -- set only one and the other side goes unmonitored.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Console security ---
# Set to "off" to disable the authenticator-app 2FA step on console login
# (e.g. while first setting up a self-hosted deployment). Any other value,
# including unset, keeps it on.
CONSOLE_MFA=

# --- Image generation for the API/MCP (optional) ---
# Lets generate_media_image (POST /api/v1/media/generate) create an image
# from a prompt and save it into the Media Library. Set at least one
# provider key to switch the feature on; with none set, the tool reports
# itself unavailable and the other upload paths (sourceUrl, svg,
# dataBase64) still work untouched.
#
# This runs server-side on purpose. An image a hosted chat client
# generates with its own built-in tool has no public URL to hand over,
# and its bytes are far too large to write into a tool call, so the only
# thing that can travel is the prompt. See src/lib/imageGeneration.ts.
#
# IMAGE_PROVIDER picks the default when more than one key is set:
# pollinations | openai | gemini. Omit it and whichever provider has a
# key is used. Each *_IMAGE_MODEL is optional and overrides that
# provider's default model.
IMAGE_PROVIDER=
# One Pollinations key reaches most of the field -- its model ids include
# openai/gpt-image-2 and google/gemini-nano-banana-2.1 -- so changing
# model usually needs no new vendor account. POLLINATIONS_IMAGE_ENDPOINT
# is optional and defaults to https://gen.pollinations.ai/image.
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=
POLLINATIONS_IMAGE_ENDPOINT=
# OpenAI's own images endpoint, billed to your OpenAI account.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# Google's native generateContent (the "nano banana" image models).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
